{
  "name": "tracker-bot",
  "version": "0.1.0",
  "description": "Tracker Competitors Bot — collect signals, gap report, response schema, Slack",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "demo": "node index.js demo",
    "serve": "node server.js",
    "collect": "node index.js collect",
    "drop": "node scripts/publish-drop.js",
    "slack-notify": "node scripts/slack-drop-notify.js",
    "test": "node test/run.js && node test/parity-check.test.js",
    "test:parity": "node test/parity-check.test.js",
    "test:parity-github": "node test/parity-github.test.js",
    "verify:core": "node scripts/verify-core-setup.js",
    "manager:preflight": "node scripts/manager-core-preflight.js",
    "verify:github-core": "node scripts/verify-github-core-access.js",
    "parity:github": "node scripts/core-parity-check.js --github --stdin",
    "preflight:publish": "node scripts/publish-preflight.js",
    "brief:readiness": "node scripts/brief-readiness-check.js",
    "brief:feed": "node scripts/tracker-feed-render.js",
    "brief:open-viewer": "node scripts/open-brief-viewer.js",
    "brief:install-opener": "node scripts/install-brief-opener.js",
    "billy:demo": "node scripts/billy-first-run-demo.js",
    "morningbrief:preflight": "node scripts/morningbrief-preflight.js",
    "morningbrief:kickoff": "node scripts/morningbrief-kickoff-publish.js",
    "publish:zero-day": "node scripts/tracker-publish-zero-day.js",
    "git:maybe-push": "node scripts/maybe-auto-push.js",
    "slack:test-operator": "node scripts/slack-webhook-test.js --target operator",
    "slack:test-billy": "node scripts/slack-webhook-test.js --target billy",
    "reclone:core": "bash scripts/reclone-core.sh",
    "test:brief": "node test/brief-feed.test.js && node test/brief-intel.test.js",
    "publish:intel": "node scripts/tracker-publish-intel.js",
    "publish:dry-run": "node scripts/tracker-publish-dry-run.js",
    "slack:brief-preflight": "node scripts/slack-brief-notify.js --mode preflight",
    "slack:brief-not-ready": "node scripts/slack-brief-notify.js --mode not-ready"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "playwright": "^1.48.0",
    "rss-parser": "^3.13.0"
  },
  "keywords": ["tracker", "competitors", "slack"],
  "license": "MIT"
}
