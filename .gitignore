# Dependencies
node_modules/

# Env and secrets
.env
.env.local
*.pem

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
# Local multi-root workspace (paths are machine-specific; use .code-workspace.example as template)
entrata-plus-tracker.code-workspace
*.swp
*.swo

# Logs and temp
*.log
tmp/
temp/

# Independent agent repo (do not track)
coding-automation-agent/

# Tracker data (collected signals)
initiative-1-tracker/tracker/data/

# Playwright browser cache — Chromium binary lives here so we don't pollute
# the user's ~/Library/Caches. Roughly 100–300 MB; never commit.
initiative-1-tracker/tracker/.playwright-browsers/

# Cached Entrata Core path (machine-specific; resolved by core-parity-check.js
# the first time it auto-discovers Core, then reused on every subsequent run
# so the manager never has to re-export ENTRATA_MONO_ROOT).
initiative-1-tracker/tracker/.core-path

# Interpretation pointer (machine-specific — tracks the last drop the manager
# closed Phase 4 on, so the dedupe + diff in the next /trackerstart can use it
# as the diff base instead of strict drops[idx-1]. Written by
# scripts/interpretation-pointer.js mark <id>.)
tracker-drops/.last-interpreted-drop-id

# Tracker Weekly Brief output (Cursor Automation Mode A writes here every
# Monday 9am MT). Markdown briefs are workspace-local audit trail — the
# manager opens them in Cursor's file tree and the continuation chat reads
# them by relative path. NOT committed because Canvas retention is
# undocumented and we wanted a stable repo-file fallback that survives
# across Cursor sessions; archiving briefs across machines is a manual
# copy-out step (e.g., copy specific briefs into a committed
# initiative-1-tracker/briefs-archive/ folder when worth preserving).
.tracker-briefs/
