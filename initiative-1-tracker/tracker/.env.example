# Optional: override feed URL per competitor (e.g. TRACKER_FEED_URL_COMPETITOR_X=https://example.com/feed.xml)
# TRACKER_FEED_URL_COMPETITOR_X=

# YouTube Data API v3 — STANDBY until key is issued (discovery + comments only; official youtube_rss feeds work without this)
# YOUTUBE_DATA_API_KEY=

# Intel fence: LLM / outbound enrichment for recommendations (must stay off until security approves any model API)
# Set to 1 only when policy allows. See config/intel-fence.json and docs/INTEL-FENCE-MVP.md
# TRACKER_LLM_ENRICHMENT=

# Optional: encrypt data/signals.json on disk (AES-256-GCM). 64 hex chars (= 32 bytes), or base64 of 32 raw bytes.
# Keep this secret; backing up the key is your responsibility. Do not commit real keys.
# openssl rand -hex 32
# TRACKER_SIGNALS_ENCRYPTION_KEY=

# Future LLM gateway (MVP: not called). After security approves: internal_http + HTTPS endpoint.
# TRACKER_LLM_MODE=off
# TRACKER_LLM_ENDPOINT=https://your-approved-internal-gateway.example/v1/chat

# Entrata PHP monolith root (folder that contains Applications/ and composer.json)
# Example (Core Repo on Desktop):
# ENTRATA_MONO_ROOT="/Users/alonso.roca/Desktop/Core Repo/entrata-core"

# Slack (for later)
# SLACK_WEBHOOK_URL=
# SLACK_BIG_MOVES_WEBHOOK_URL=
